# Three programs read settings like these: the web app (first part), the worker, which
# shares most of the web app's (second part), and the live stat tracker (third part).
# Copy this file to .env (which is never committed) and fill in what you need. The
# tests never read .env.
#
# Both programs use the name DATABASE_URL. npm run dev:stats, stats:db-check and
# stats:copy read .env too, so a .env made for the web app also points the tracker at
# the web app's database. To run the tracker as before, keep the tracker's settings in a
# .env of their own (or comment out the web app's DATABASE_URL line).

# --- Web app -------------------------------------------------------------------------
# Every setting the web app reads (apps/web/src/server/config-schema.ts).
# All values below are made up.
# Lines marked SECRET must never be committed with real values; real ones live in the
# hosting provider's secret store, different in every environment (T-30).
# The app refuses to start if one is missing or invalid.

# local, test, staging or production
APP_ENV=local
PUBLIC_BASE_URL=http://localhost:3000
# optional: debug, info, warn or error (default info)
LOG_LEVEL=info
# none or one. Optional in local and test (default none); REQUIRED in staging and
# production, where the app refuses to start without it. "one" only when exactly one
# proxy of the host stands in front of the app and appends the address it was reached
# from; the sign-in attempt limits then count per visitor network. With "none" every
# visitor shares one address, so one person's wrong guesses can lock out everyone.
TRUSTED_PROXY=none
SUPABASE_URL=http://localhost:54321
EMAIL_FROM=hello@example.test

# SECRET
DATABASE_URL=postgres://app:made-up-password@localhost:5432/league_local
# SECRET (at least 32 characters)
SESSION_SECRET=made-up-session-secret-0123456789abcdef
# SECRET
SUPABASE_SECRET_KEY=made-up-supabase-key
# SECRET
RESEND_API_KEY=made-up-resend-key
# SECRET
STRIPE_SECRET_KEY=made-up-stripe-key
# SECRET
STRIPE_WEBHOOK_SECRET=made-up-webhook-key

# --- Worker --------------------------------------------------------------------------
# npm run start:worker reads APP_ENV, LOG_LEVEL, DATABASE_URL, PUBLIC_BASE_URL,
# EMAIL_FROM and RESEND_API_KEY above, and the two below (apps/worker/src/config-schema.ts).
# In local and test it never opens DATABASE_URL: it runs on a made-up database in memory.
# DATABASE_URL is required in staging and production, RESEND_API_KEY in production only.
# On a hosted database its login must be a member of app_user and of queue_owner
# (record 053). The worker refuses to start if a setting is missing or invalid.

# optional: the port its health check listens on (default 3001; 0, any free port, only
# when APP_ENV is test)
# WORKER_HEALTH_PORT=3001
# optional, outside production: a folder each captured email is also written to
# EMAIL_CAPTURE_DIR=.local/captured-email

# --- Live stat tracker ---------------------------------------------------------------
# npm run dev:stats, stats:db-check and stats:copy read these.

# Save to Supabase instead of this computer. In Supabase: Connect → Session pooler →
# copy the connection string and put your database password in place of [YOUR-PASSWORD].
# Check it with: npm run stats:db-check
# DATABASE_URL=postgresql://postgres.abcdefghijklmnopqrst:your-database-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Optional: Supabase's SSL certificate (Database settings → SSL), as a file path, so the
# server's identity is verified as well as the connection encrypted.
# DATABASE_CA=./prod-ca-2021.crt

# Let phones on the same Wi-Fi watch live (and, with a passcode, score).
# LIVE_STATS_LAN=1
# LIVE_STATS_SCORER_PASSCODE=

# Online hosting only: see docs/operations/live-stats-hosting.md.
# LIVE_STATS_PUBLIC_URL=https://stats.example.org
