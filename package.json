{
  "name": "league-platform",
  "version": "0.1.0",
  "private": true,
  "description": "League platform specifications, live stat tracking for Al-Hadi varsity, and preserved concepts",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/serve-demo.mjs",
    "dev:web": "node --env-file-if-exists=.env scripts/web.mjs dev",
    "build:web": "node scripts/web.mjs build",
    "start:web": "node --env-file-if-exists=.env scripts/web.mjs start",
    "test:web": "node scripts/check-web-shell.mjs",
    "start:worker": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning apps/worker/src/main.ts",
    "dev:stats": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning apps/live-stats/server.ts",
    "stats:db-check": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning apps/live-stats/db-check.ts",
    "stats:copy": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning apps/live-stats/copy.ts",
    "build:demo": "node scripts/build-demo.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "build:supabase": "node --disable-warning=ExperimentalWarning scripts/build-supabase-sql.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "pretest": "node scripts/prepare-varsity-hosted.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "test:varsity:browser": "node scripts/check-varsity-browser.mjs",
    "test:stats:browser": "node scripts/check-live-stats-browser.mjs",
    "test:pages:browser": "node --disable-warning=ExperimentalWarning scripts/check-pages-browser.mjs",
    "test:web:browser": "node tests/browser/web-exit-test.mjs && node tests/browser/fixture-import-test.mjs --no-build && node tests/browser/schedule-grid-test.mjs --no-build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run typecheck && npm test && npm run test:units && npm run test:web && npm run format:check && npm run build:demo",
    "capture:presentation": "node scripts/capture-presentation.mjs",
    "dev:varsity": "node apps/varsity-preview/server.ts",
    "prepare:varsity:hosted": "node scripts/prepare-varsity-hosted.mjs",
    "prepare:varsity:publish": "node scripts/prepare-varsity-publish.mjs",
    "typecheck": "tsc --project tsconfig.varsity.json && tsc --project tsconfig.workspaces.json && tsc --project apps/web/tsconfig.json && tsc --project packages/ui/tsconfig.json",
    "test:units": "vitest run",
    "seed": "node --disable-warning=ExperimentalWarning packages/database/scripts/seed-leagues.ts",
    "db:types": "node packages/database/scripts/generate-schema-types.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "0.2.15",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.1",
    "fake-indexeddb": "6.2.7",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "zod": "4.6.7"
  },
  "workspaces": [
    "apps/web",
    "apps/worker",
    "packages/core",
    "packages/site",
    "packages/ui",
    "packages/emails",
    "packages/providers",
    "packages/observability",
    "packages/contracts",
    "packages/database",
    "packages/sports"
  ]
}
