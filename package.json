{
  "name": "league-platform",
  "version": "0.1.0",
  "private": true,
  "description": "League platform specifications, preserved intramural concept, and Al-Hadi varsity scoring rehearsal",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/serve-demo.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "pretest": "node scripts/prepare-varsity-hosted.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "test:varsity:browser": "node scripts/check-varsity-browser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run typecheck && npm test && npm run format:check && npm run build:demo",
    "capture:presentation": "node scripts/capture-presentation.mjs",
    "dev:varsity": "node apps/varsity-preview/server.ts",
    "prepare:varsity:hosted": "node scripts/prepare-varsity-hosted.mjs",
    "prepare:varsity:publish": "node scripts/prepare-varsity-publish.mjs",
    "typecheck": "tsc --project tsconfig.varsity.json"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12",
    "zod": "4.6.7"
  }
}
